  let kbCurrentFilter = 'all';
  let kbCurrentSearch = '';

  function kbAllCats() {
    const custom = KB_STORE.custom();
    return [
      ...KB_DEFAULT_CATS.map(c => ({
        ...c,
        name: custom[c.id]?.name || c.name,
        icon: custom[c.id]?.icon || c.icon,
      })),
      ...KB_STORE.cats()
    ];
  }

  function kbDomainOf(url) {
    try { return new URL(url).hostname.replace('www.',''); } catch { return url.replace(/^https?:\/\/(www\.)?/,'').split('/')[0]; }
  }

  function kbSanitize(s) {
    const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
  }

  // Build or rebuild all KB sections from scratch
  function kbRender() {
    const sc  = document.getElementById('kbSectionsContainer');
    const usc = document.getElementById('kbUserSectionsContainer');
    sc.innerHTML = ''; usc.innerHTML = '';

    const deleted = KB_STORE.del();
    const userLinks = KB_STORE.links();
    const allCats = kbAllCats();

    allCats.forEach(cat => {
      // Collect default links for this category (not deleted)
      const dLinks = KB_DEFAULT_LINKS.filter(l => l.cat === cat.id && !deleted.includes(l.id));
      // Collect user links for this category
      const uLinks = userLinks.filter(l => l.cat === cat.id);
      const all = [...dLinks, ...uLinks];
      if (!all.length && !cat.isDefault) return; // hide empty custom cats

      const sec = kbMakeSection(cat, all);
      if (cat.isDefault) sc.appendChild(sec);
      else usc.appendChild(sec);
    });

    kbUpdateStats();
    kbApplyFilter(kbCurrentFilter);
    kbApplySearch(kbCurrentSearch);
    kbRebuildFilterChips();
  }

  function kbMakeSection(cat, links) {
    const sec = document.createElement('section');
    sec.className = 'kb-section';
    sec.id = 'kb-cat-' + cat.id;
    sec.dataset.cat = cat.id;

    const head = document.createElement('div');
    head.className = 'kb-section-head';
    head.innerHTML = `
      <span class="kb-section-icon">${cat.icon}</span>
      <h3>${kbSanitize(cat.name)}</h3>
      <div class="kb-section-divider"></div>
      <span class="kb-section-count" id="kbcnt-${cat.id}">${links.length} link${links.length !== 1 ? 's' : ''}</span>
      <button class="kb-section-toggle" data-cat="${cat.id}"><i>▼</i></button>
    `;
    sec.appendChild(head);

    const grid = document.createElement('div');
    grid.className = 'kb-grid';
    grid.id = 'kbgrid-' + cat.id;
    links.forEach(l => grid.appendChild(kbMakeCard(l, !l.id.startsWith('dl_'))));
    sec.appendChild(grid);

    // Check collapse state from localStorage
    const kbCol = JSON.parse(localStorage.getItem('kb_collapsed') || '{}');
    if (kbCol[cat.id]) {
      sec.classList.add('collapsed');
    }

    // Toggle collapse on button click
    const toggleBtn = head.querySelector('.kb-section-toggle');
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      sec.classList.toggle('collapsed');
      const current = JSON.parse(localStorage.getItem('kb_collapsed') || '{}');
      current[cat.id] = sec.classList.contains('collapsed');
      localStorage.setItem('kb_collapsed', JSON.stringify(current));
    });

    return sec;
  }

  function kbMakeCard(link, isUser) {
    const a = document.createElement('a');
    a.href   = link.url;
    a.target = '_blank';
    a.rel    = 'noopener';
    a.className = 'kb-link-card';
    a.dataset.linkId  = link.id;
    a.dataset.cat     = link.cat || link.category || '';
    a.dataset.title   = (link.title || '').toLowerCase();
    a.dataset.url     = kbDomainOf(link.url);
    a.setAttribute('aria-label', link.title);

    a.innerHTML = `
      <div class="kb-card-icon">${link.icon || '🔗'}</div>
      <div class="kb-card-body">
        <div class="kb-card-title">${kbSanitize(link.title)}</div>
        <div class="kb-card-url">${kbDomainOf(link.url)}</div>
      </div>
      <span class="kb-card-arrow">↗</span>
      <button class="kb-card-del" aria-label="Delete ${kbSanitize(link.title)}" tabindex="-1">✕</button>
    `;

    a.querySelector('.kb-card-del').addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      kbDeleteLink(link.id, isUser);
    });

    return a;
  }

  function kbDeleteLink(id, isUser) {
    if (!confirm('Delete this link?')) return;
    if (isUser) {
      KB_STORE.set(KB_KEYS.links, KB_STORE.links().filter(l => l.id !== id));
    } else {
      const d = KB_STORE.del();
      if (!d.includes(id)) { d.push(id); KB_STORE.set(KB_KEYS.del, d); }
    }
    document.querySelector(`.kb-link-card[data-link-id="${id}"]`)?.remove();
    kbUpdateStats();
    kbApplySearch(kbCurrentSearch);
    toast('Link deleted');
  }

  function kbUpdateStats() {
    const allCards = document.querySelectorAll('.kb-link-card');
    const userLinks = KB_STORE.links();
    document.getElementById('kbStatTotal').textContent  = allCards.length;
    document.getElementById('kbStatCats').textContent   = kbAllCats().length;
    document.getElementById('kbStatCustom').textContent = userLinks.length;
    document.getElementById('kbStatDate').textContent   = new Date().toLocaleDateString('en-IE',{day:'numeric',month:'short'});

    // Update section counts
    document.querySelectorAll('.kb-section').forEach(sec => {
      const catId = sec.dataset.cat;
      const ct = document.getElementById('kbcnt-' + catId);
      if (ct) {
        const n = sec.querySelectorAll('.kb-link-card:not(.kb-hidden)').length;
        ct.textContent = `${n} link${n !== 1 ? 's' : ''}`;
      }
    });
  }

  // ─── FILTER ───
  function kbFilter(btn, cat) {
    kbCurrentFilter = cat;
    document.querySelectorAll('.kb-filter-chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    kbApplyFilter(cat);
    kbApplySearch(kbCurrentSearch);
  }

  function kbApplyFilter(cat) {
    document.querySelectorAll('.kb-section').forEach(sec => {
      const match = cat === 'all' || sec.dataset.cat === cat;
      sec.style.display = match ? '' : 'none';
    });
  }

  // ─── SEARCH ───
  const kbSearchEl = document.getElementById('kbSearchInput');
  const kbClearEl  = document.getElementById('kbSearchClear');

  kbSearchEl.addEventListener('input', () => {
    kbCurrentSearch = kbSearchEl.value.toLowerCase().trim();
    kbClearEl.classList.toggle('visible', !!kbCurrentSearch);
    kbApplySearch(kbCurrentSearch);
  });

  function kbClearSearch() {
    kbSearchEl.value = '';
    kbCurrentSearch = '';
    kbClearEl.classList.remove('visible');
    kbApplySearch('');
  }

  function kbApplySearch(q) {
    let visible = 0;
    document.querySelectorAll('.kb-link-card').forEach(card => {
      const inCat = kbCurrentFilter === 'all' || card.dataset.cat === kbCurrentFilter;
      const inSearch = !q || card.dataset.title.includes(q) || card.dataset.url.includes(q);
      const show = inCat && inSearch;
      card.classList.toggle('kb-hidden', !show);
      if (show) visible++;
    });
    document.getElementById('kbNoResults').classList.toggle('show', visible === 0);
    kbUpdateStats();
  }

  // Cmd+K focuses KB search when on KB page
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      const kbPage = document.getElementById('page-kb');
      if (kbPage && kbPage.classList.contains('active')) {
        e.preventDefault();
        kbSearchEl.focus(); kbSearchEl.select();
      }
    }
  });

  // ─── CATEGORY FILTER CHIPS: rebuild to include custom cats ───
  function kbRebuildFilterChips() {
    const container = document.getElementById('kbFilterChips');
    if (!container) return;
    container.innerHTML = '';
    const cats = kbAllCats();
    const allBtn = document.createElement('button');
    allBtn.className = 'kb-filter-chip' + (kbCurrentFilter === 'all' ? ' active' : '');
    allBtn.dataset.filter = 'all';
    allBtn.textContent = 'All';
    allBtn.onclick = () => kbFilter(allBtn, 'all');
    container.appendChild(allBtn);
    cats.forEach(cat => {
      const btn = document.createElement('button');
      btn.className = 'kb-filter-chip' + (kbCurrentFilter === cat.id ? ' active' : '');
      btn.dataset.filter = cat.id;
      btn.innerHTML = `${cat.icon} ${kbSanitize(cat.name)}`;
      btn.onclick = () => kbFilter(btn, cat.id);
      container.appendChild(btn);
    });
  }

  // ─── ADD LINK MODAL ───
  function kbOpenAdd() {
    kbPopulateCatDropdown();
    kbOpenModal('kbAddModal');
  }

  function kbPopulateCatDropdown() {
    const sel = document.getElementById('kbNewCat');
    const cur = sel.value;
    sel.innerHTML = '<option value="">Select…</option>';
    kbAllCats().forEach(cat => {
      const o = new Option(`${cat.icon} ${cat.name}`, cat.id);
      sel.appendChild(o);
    });
    if (cur) sel.value = cur;
  }

  function kbSubmitAdd() {
    const title = document.getElementById('kbNewTitle').value.trim();
    const rawUrl = document.getElementById('kbNewUrl').value.trim();
    const cat   = document.getElementById('kbNewCat').value;
    const icon  = document.getElementById('kbNewIcon').value.trim();

    let valid = true;
    const te = document.getElementById('kbNewTitleErr');
    const ue = document.getElementById('kbNewUrlErr');
    const ce = document.getElementById('kbNewCatErr');

    te.style.display = !title ? 'block' : 'none'; if (!title) valid = false;
    const urlOk = rawUrl && /^https?:\/\//.test(rawUrl);
    ue.style.display = !urlOk ? 'block' : 'none'; if (!urlOk) valid = false;
    ce.style.display = !cat ? 'block' : 'none'; if (!cat) valid = false;
    if (!valid) return;

    const link = {
      id: 'u_' + Date.now(),
      title: kbSanitize(title),
      url: rawUrl,
      cat,
      icon: kbSanitize(icon) || '🔗'
    };

    const links = KB_STORE.links();
    links.push(link);
    KB_STORE.set(KB_KEYS.links, links);

    // Add card to existing grid or create section
    let grid = document.getElementById('kbgrid-' + cat);
    if (!grid) {
      const catObj = kbAllCats().find(c => c.id === cat);
      if (catObj) {
        const sec = kbMakeSection(catObj, [link]);
        document.getElementById('kbUserSectionsContainer').appendChild(sec);
        grid = null; // section already has card
      }
    } else {
      grid.appendChild(kbMakeCard(link, true));
    }

    ['kbNewTitle','kbNewUrl','kbNewIcon'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('kbNewCat').value = '';
    ['kbNewTitleErr','kbNewUrlErr','kbNewCatErr'].forEach(id => document.getElementById(id).style.display = 'none');

    kbCloseModal('kbAddModal');
    kbUpdateStats();
    kbRebuildFilterChips();
    toast('KB link added!');
  }

