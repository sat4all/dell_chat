<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Dell PowerStore Chat Support Toolkit — EMEA Midrange Storage Support">
  <meta name="theme-color" content="#0a0f1e">
  <title>Dell Support Toolkit</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    /* ─────────────────────────────────────────────
       CSS CUSTOM PROPERTIES
    ───────────────────────────────────────────── */
    :root {
      --bg:           #f5f6fa;
      --surface:      #ffffff;
      --surface2:     #f0f2f8;
      --border:       #e2e5ef;
      --border2:      #c8cede;
      --text:         #0d111c;
      --text-muted:   #6b7280;
      --text-faint:   #9ca3af;
      --accent:       #0057ff;
      --accent-hover: #0042cc;
      --accent-soft:  #e8f0ff;
      --green:        #00b67a;
      --green-soft:   #e0f7ef;
      --red:          #e53e3e;
      --red-soft:     #fee8e8;
      --amber:        #f59e0b;
      --amber-soft:   #fef3c7;
      --purple:       #7c3aed;
      --purple-soft:  #ede9fe;
      --navy:         #0a0f1e;
      --shadow-sm:    0 1px 3px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04);
      --shadow:       0 4px 16px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.05);
      --shadow-lg:    0 20px 60px rgba(0,0,0,.12), 0 4px 16px rgba(0,0,0,.06);
      --radius-sm:    8px;
      --radius:       14px;
      --radius-lg:    20px;
      --radius-xl:    28px;
      --font:         'DM Sans', sans-serif;
      --mono:         'DM Mono', monospace;
      --transition:   0.18s cubic-bezier(.4,0,.2,1);
      --sidebar-w:    260px;
    }

    /* Dark Mode */
    .dark {
      --bg:           #0d1117;
      --surface:      #161b27;
      --surface2:     #1c2232;
      --border:       #252d3e;
      --border2:      #2f3a52;
      --text:         #e8ecf5;
      --text-muted:   #8892a4;
      --text-faint:   #5a6478;
      --accent-soft:  #0e2054;
      --green-soft:   #042b1e;
      --red-soft:     #2d0f0f;
      --amber-soft:   #2d1f05;
      --purple-soft:  #1e1040;
      --shadow-sm:    0 1px 3px rgba(0,0,0,.4);
      --shadow:       0 4px 16px rgba(0,0,0,.5);
      --shadow-lg:    0 20px 60px rgba(0,0,0,.6);
    }

    /* ─────────────────────────────────────────────
       RESET + BASE
    ───────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; font-size: 15px; }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      transition: background var(--transition), color var(--transition);
      min-height: 100vh;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    button { font-family: var(--font); cursor: pointer; border: none; outline: none; }
    input, textarea, select { font-family: var(--font); }

    /* Skip link */
    .skip-link {
      position: absolute; top: -50px; left: 16px;
      background: var(--accent); color: #fff; padding: 8px 16px;
      border-radius: var(--radius-sm); z-index: 9999;
      transition: top .2s;
    }
    .skip-link:focus { top: 16px; }

    /* ─────────────────────────────────────────────
       LAYOUT: SIDEBAR + MAIN
    ───────────────────────────────────────────── */
    .layout { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border);
      position: fixed; left: 0; top: 0; bottom: 0;
      overflow-y: auto; overflow-x: hidden;
      display: flex; flex-direction: column;
      z-index: 200;
      transition: transform var(--transition), background var(--transition);
    }

    .sidebar-logo {
      padding: 20px 20px 12px;
      display: flex; align-items: center; gap: 10px;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-logo-mark {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--accent), #0042cc);
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #fff; font-size: 14px; letter-spacing: -0.5px;
      flex-shrink: 0;
    }

    .sidebar-logo-text { font-weight: 600; font-size: 14px; line-height: 1.2; }
    .sidebar-logo-sub { font-size: 11px; color: var(--text-muted); font-weight: 400; }

    .sidebar-nav { padding: 12px 10px; flex: 1; }

    .nav-section-label {
      font-size: 10.5px; font-weight: 600; letter-spacing: .08em;
      text-transform: uppercase; color: var(--text-faint);
      padding: 4px 10px 8px;
    }

    .nav-item {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 10px; border-radius: var(--radius-sm);
      font-size: 13.5px; font-weight: 500; color: var(--text-muted);
      cursor: pointer; transition: all var(--transition);
      margin-bottom: 2px; border: none; background: none; width: 100%;
      text-align: left;
    }

    .nav-item:hover { background: var(--surface2); color: var(--text); }
    .nav-item.active { background: var(--accent-soft); color: var(--accent); }
    .nav-item.active .nav-icon { color: var(--accent); }

    .nav-icon { width: 18px; height: 18px; flex-shrink: 0; opacity: .75; }
    .nav-item.active .nav-icon { opacity: 1; }

    .sidebar-bottom {
      padding: 12px 10px;
      border-top: 1px solid var(--border);
    }

    /* Main content */
    .main {
      margin-left: var(--sidebar-w);
      flex: 1;
      padding: 28px;
      max-width: 100%;
    }

    /* Topbar */
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 28px; gap: 12px; flex-wrap: wrap;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }
    .topbar-title { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; }
    .topbar-sub { font-size: 13px; color: var(--text-muted); margin-top: 1px; }

    .topbar-actions { display: flex; align-items: center; gap: 8px; }

    .hamburger {
      display: none;
      padding: 7px; border-radius: var(--radius-sm);
      background: var(--surface2); color: var(--text);
      border: 1px solid var(--border);
    }

    /* ─────────────────────────────────────────────
       SECTIONS (pages)
    ───────────────────────────────────────────── */
    .page { display: none; animation: fadeIn .25s ease; }
    .page.active { display: block; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* ─────────────────────────────────────────────
       CARDS
    ───────────────────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      padding: 24px;
      transition: background var(--transition), border var(--transition);
    }

    .card + .card { margin-top: 20px; }

    .card-title {
      font-size: 15px; font-weight: 700;
      letter-spacing: -0.2px; margin-bottom: 18px;
      display: flex; align-items: center; gap: 8px;
    }

    .card-title-icon {
      width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; flex-shrink: 0;
    }

    /* ─────────────────────────────────────────────
       FORM ELEMENTS
    ───────────────────────────────────────────── */
    .form-group { margin-bottom: 16px; }
    .form-group:last-child { margin-bottom: 0; }

    label {
      display: block; font-size: 12.5px; font-weight: 600;
      color: var(--text-muted); margin-bottom: 6px;
      letter-spacing: 0.01em;
    }

    .form-control {
      width: 100%; padding: 10px 13px;
      background: var(--surface2); color: var(--text);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); font-size: 14px;
      transition: all var(--transition); outline: none;
      appearance: none; -webkit-appearance: none;
    }

    .form-control:hover { border-color: var(--border2); }
    .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0,87,255,.12); background: var(--surface); }

    textarea.form-control { resize: vertical; min-height: 80px; }

    .input-group { display: flex; align-items: stretch; }
    .input-group-text {
      padding: 10px 12px; background: var(--surface2);
      border: 1.5px solid var(--border); border-right: none;
      border-radius: var(--radius-sm) 0 0 var(--radius-sm);
      color: var(--text-muted); font-size: 14px; font-weight: 500;
    }
    .input-group .form-control { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }

    .form-hint {
      font-size: 11.5px; color: var(--text-faint); margin-top: 5px;
    }

    /* ─────────────────────────────────────────────
       BUTTONS
    ───────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 7px; padding: 9px 16px; border-radius: var(--radius-sm);
      font-size: 13.5px; font-weight: 600; letter-spacing: 0.01em;
      transition: all var(--transition); position: relative; overflow: hidden;
      white-space: nowrap; flex-shrink: 0;
    }

    .btn::after {
      content: ''; position: absolute; inset: 0;
      background: rgba(255,255,255,0.14); opacity: 0;
      transition: opacity var(--transition);
    }
    .btn:hover::after { opacity: 1; }
    .btn:active { transform: scale(0.97); }

    .btn-primary {
      background: var(--accent); color: #fff;
      box-shadow: 0 1px 3px rgba(0,87,255,.3);
    }
    .btn-primary:hover { background: var(--accent-hover); }

    .btn-success {
      background: var(--green); color: #fff;
      box-shadow: 0 1px 3px rgba(0,182,122,.3);
    }

    .btn-danger {
      background: var(--red); color: #fff;
      box-shadow: 0 1px 3px rgba(229,62,62,.3);
    }

    .btn-ghost {
      background: var(--surface2); color: var(--text);
      border: 1.5px solid var(--border);
    }
    .btn-ghost:hover { background: var(--border); }

    .btn-amber {
      background: var(--amber); color: #fff;
      box-shadow: 0 1px 3px rgba(245,158,11,.3);
    }

    .btn-outline {
      background: transparent; color: var(--text-muted);
      border: 1.5px solid var(--border);
    }
    .btn-outline:hover { background: var(--surface2); color: var(--text); }

    .btn-sm { padding: 6px 11px; font-size: 12.5px; }
    .btn-lg { padding: 12px 22px; font-size: 15px; border-radius: var(--radius); }
    .btn-block { width: 100%; }
    .btn-icon { padding: 9px; border-radius: var(--radius-sm); }

    /* ─────────────────────────────────────────────
       BADGE
    ───────────────────────────────────────────── */
    .badge {
      display: inline-flex; align-items: center;
      padding: 3px 8px; border-radius: 100px;
      font-size: 11px; font-weight: 600;
    }
    .badge-blue { background: var(--accent-soft); color: var(--accent); }
    .badge-green { background: var(--green-soft); color: var(--green); }
    .badge-red { background: var(--red-soft); color: var(--red); }
    .badge-amber { background: var(--amber-soft); color: #b45309; }

    /* ─────────────────────────────────────────────
       QUICK COPY BUTTONS GRID
    ───────────────────────────────────────────── */
    .quick-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 8px;
      margin-bottom: 16px;
    }

    .quick-btn {
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 9px 12px;
      font-size: 12.5px; font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all var(--transition);
      text-align: center;
      position: relative;
    }
    .quick-btn:hover {
      background: var(--accent-soft); color: var(--accent);
      border-color: rgba(0,87,255,.25);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }
    .quick-btn:active { transform: scale(0.97); }

    /* Tooltip */
    .quick-btn::before {
      content: attr(data-tip);
      position: absolute; bottom: calc(100% + 8px); left: 50%;
      transform: translateX(-50%);
      background: var(--navy); color: #e8ecf5;
      padding: 7px 12px; border-radius: 8px;
      font-size: 11.5px; font-weight: 400; line-height: 1.5;
      white-space: normal; word-break: break-word;
      width: 280px; text-align: left;
      opacity: 0; pointer-events: none;
      transition: opacity .2s ease;
      z-index: 100;
      box-shadow: 0 8px 24px rgba(0,0,0,.25);
    }
    .quick-btn:hover::before { opacity: 1; }

    /* ─────────────────────────────────────────────
       QUICK LINKS BAR
    ───────────────────────────────────────────── */
    .links-bar {
      display: flex; flex-wrap: wrap; gap: 6px;
      padding: 14px 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 20px;
    }

    .link-chip {
      display: inline-flex; align-items: center;
      padding: 5px 11px; border-radius: 100px;
      font-size: 12px; font-weight: 600; color: var(--text-muted);
      background: var(--surface2); border: 1px solid var(--border);
      cursor: pointer; transition: all var(--transition);
      white-space: nowrap;
    }
    .link-chip:hover {
      background: var(--accent-soft); color: var(--accent);
      border-color: rgba(0,87,255,.3);
    }

    /* ─────────────────────────────────────────────
       HANDOVER ENTRIES
    ───────────────────────────────────────────── */
    .entry-block {
      background: var(--surface2);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
      margin-bottom: 12px;
      transition: border-color var(--transition);
    }
    .entry-block:hover { border-color: var(--border2); }

    .entry-block .entry-head {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 14px;
    }
    .entry-block .entry-label {
      font-size: 12.5px; font-weight: 700; color: var(--text);
      display: flex; align-items: center; gap: 6px;
    }
    .entry-num {
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--accent); color: #fff;
      font-size: 11px; font-weight: 700;
      display: inline-flex; align-items: center; justify-content: center;
    }

    .entry-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    /* ─────────────────────────────────────────────
       CODE RED SECTION
    ───────────────────────────────────────────── */
    .cr-warning-banner {
      background: var(--red-soft);
      border: 1.5px solid rgba(229,62,62,.25);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 12.5px; font-weight: 600; color: var(--red);
      margin-bottom: 20px;
      display: flex; align-items: center; gap: 8px;
    }

    .cr-section-header {
      font-size: 11px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: var(--red);
      padding: 14px 0 10px; border-bottom: 1px solid var(--border);
      margin-bottom: 14px;
    }

    .check-group { display: flex; flex-direction: column; gap: 8px; }

    .check-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; background: var(--surface2);
      border: 1.5px solid var(--border); border-radius: var(--radius-sm);
      cursor: pointer; transition: all var(--transition);
    }
    .check-item:hover { border-color: var(--border2); }
    .check-item input[type="checkbox"] {
      width: 16px; height: 16px; accent-color: var(--accent);
      flex-shrink: 0; cursor: pointer;
    }
    .check-item label { margin: 0; font-size: 13.5px; color: var(--text); font-weight: 500; cursor: pointer; }
    .check-item.required label { color: var(--red); }

    .word-counter {
      font-size: 11.5px; color: var(--text-faint);
      text-align: right; margin-top: 4px;
    }
    .word-counter.warn { color: var(--amber); }
    .word-counter.over { color: var(--red); }

    /* ─────────────────────────────────────────────
       WORLD CLOCK
    ───────────────────────────────────────────── */
    .clocks-scroll {
      display: flex; gap: 12px;
      overflow-x: auto; padding-bottom: 8px;
      scroll-snap-type: x mandatory;
    }
    .clocks-scroll::-webkit-scrollbar { height: 4px; }
    .clocks-scroll::-webkit-scrollbar-track { background: transparent; }
    .clocks-scroll::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 99px; }

    .clock-card {
      flex-shrink: 0; width: 175px;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 16px; cursor: grab;
      scroll-snap-align: start;
      transition: all var(--transition);
      position: relative;
    }
    .clock-card:hover { border-color: var(--accent); box-shadow: var(--shadow); }
    .clock-card.dragging { opacity: 0.5; }

    .clock-city { font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .clock-time { font-family: var(--mono); font-size: 26px; font-weight: 500; color: var(--text); letter-spacing: -0.5px; line-height: 1; }
    .clock-meta { font-size: 10.5px; color: var(--text-faint); margin-top: 8px; }
    .clock-remove {
      position: absolute; top: 8px; right: 8px;
      background: var(--red-soft); color: var(--red);
      border: none; border-radius: 50%; width: 20px; height: 20px;
      font-size: 12px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity var(--transition);
    }
    .clock-card:hover .clock-remove { opacity: 1; }

    .search-dropdown {
      position: absolute; top: calc(100% + 4px); left: 0; right: 0;
      background: var(--surface); border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); z-index: 50;
      max-height: 220px; overflow-y: auto;
      box-shadow: var(--shadow);
    }
    .search-opt {
      padding: 9px 13px; font-size: 13px; cursor: pointer;
      display: flex; justify-content: space-between; align-items: center;
      transition: background var(--transition);
    }
    .search-opt:hover { background: var(--surface2); }
    .search-opt-time { font-family: var(--mono); font-size: 12px; color: var(--text-muted); }
    .search-wrap { position: relative; }

    /* ─────────────────────────────────────────────
       POSTCODE TABLE
    ───────────────────────────────────────────── */
    .table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); }

    table {
      border-collapse: collapse; width: 100%;
      font-size: 12.5px; background: var(--surface);
    }
    th {
      background: var(--surface2);
      color: var(--text-muted);
      font-size: 11px; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; padding: 10px 12px;
      border-bottom: 1px solid var(--border); white-space: nowrap;
      text-align: left;
    }
    td {
      padding: 9px 12px; border-bottom: 1px solid var(--border);
      color: var(--text);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--surface2); }

    td.tc { text-align: center; }
    .yes { color: var(--green); font-weight: 700; }
    .no  { color: var(--red); font-weight: 700; }
    .wud { color: #0284c7; font-weight: 700; }

    .region-row {
      background: var(--surface2) !important;
      cursor: pointer;
    }
    .region-row td {
      font-size: 12px; font-weight: 700; letter-spacing: .04em;
      text-transform: uppercase; color: var(--text-muted);
    }
    .region-row:hover td { color: var(--text); }
    .collapsed { display: none; }

    /* Filter row */
    .table-filters {
      display: flex; gap: 8px; flex-wrap: wrap;
      margin-bottom: 12px; align-items: center;
    }
    .filter-input {
      padding: 7px 12px; border-radius: var(--radius-sm);
      border: 1.5px solid var(--border); background: var(--surface2);
      color: var(--text); font-size: 13px; outline: none;
      transition: all var(--transition);
    }
    .filter-input:focus { border-color: var(--accent); background: var(--surface); }
    .filter-input::placeholder { color: var(--text-faint); }

    /* ─────────────────────────────────────────────
       TOAST NOTIFICATION
    ───────────────────────────────────────────── */
    .toast-container {
      position: fixed; bottom: 24px; right: 24px;
      z-index: 9999; display: flex; flex-direction: column; gap: 8px;
    }

    .toast {
      display: flex; align-items: center; gap: 10px;
      background: var(--navy); color: #e8ecf5;
      padding: 12px 18px; border-radius: var(--radius);
      font-size: 13.5px; font-weight: 500;
      box-shadow: var(--shadow-lg);
      transform: translateX(120%); opacity: 0;
      transition: all .35s cubic-bezier(.22,.68,0,1.2);
      min-width: 220px; max-width: 360px;
    }
    .dark .toast { background: var(--surface); border: 1px solid var(--border); color: var(--text); }
    .toast.show { transform: translateX(0); opacity: 1; }
    .toast-icon { font-size: 17px; flex-shrink: 0; }

    /* ─────────────────────────────────────────────
       MODAL
    ───────────────────────────────────────────── */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.45);
      z-index: 500; display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity .2s ease;
      padding: 16px;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal-box {
      background: var(--surface); border-radius: var(--radius-xl);
      border: 1px solid var(--border); box-shadow: var(--shadow-lg);
      width: 100%; max-width: 640px; max-height: 88vh;
      overflow-y: auto;
      transform: translateY(20px) scale(.97); opacity: 0;
      transition: all .25s cubic-bezier(.22,.68,0,1.2);
    }
    .modal-overlay.open .modal-box { transform: translateY(0) scale(1); opacity: 1; }

    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 24px; border-bottom: 1px solid var(--border);
      position: sticky; top: 0; background: var(--surface); z-index: 1;
    }
    .modal-head h2 { font-size: 16px; font-weight: 700; }
    .modal-close {
      width: 30px; height: 30px; border-radius: 50%; background: var(--surface2);
      border: 1px solid var(--border); color: var(--text-muted);
      font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: all var(--transition);
    }
    .modal-close:hover { background: var(--red-soft); color: var(--red); }
    .modal-body { padding: 20px 24px; }
    .modal-foot {
      padding: 16px 24px; border-top: 1px solid var(--border);
      display: flex; justify-content: flex-end; gap: 8px;
    }

    .msg-edit-item {
      margin-bottom: 16px; padding: 14px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: var(--radius-sm);
    }
    .msg-edit-item label { color: var(--text); font-size: 12.5px; margin-bottom: 6px; }
    .msg-edit-item textarea { min-height: 70px; }

    /* ─────────────────────────────────────────────
       THEME TOGGLE
    ───────────────────────────────────────────── */
    .theme-toggle {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--surface2); border: 1.5px solid var(--border);
      color: var(--text-muted); font-size: 16px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: all var(--transition);
    }
    .theme-toggle:hover { background: var(--accent-soft); color: var(--accent); }

    /* ─────────────────────────────────────────────
       COPY ICON
    ───────────────────────────────────────────── */
    .copy-icon {
      width: 20px; height: 20px;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 14px;
      display: inline-flex; align-items: center; justify-content: center;
      transition: all var(--transition);
      margin-left: 6px;
      flex-shrink: 0;
    }
    .copy-icon:hover { color: var(--accent); transform: scale(1.1); }
    .copy-icon.copied { color: var(--green); }
    .copy-wrapper {
      display: flex; align-items: center; gap: 4px;
    }

    /* ─────────────────────────────────────────────
       MOBILE RESPONSIVE
    ───────────────────────────────────────────── */
    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
        box-shadow: var(--shadow-lg);
      }
      .sidebar.open { transform: translateX(0); }

      .main { margin-left: 0; padding: 16px; }
      .hamburger { display: flex; }
      .topbar { margin-bottom: 18px; }

      .entry-grid { grid-template-columns: 1fr; }
      .quick-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }

      .mobile-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        z-index: 199; display: none;
      }
      .mobile-overlay.open { display: block; }

      .toast-container { bottom: 16px; right: 16px; left: 16px; }
      .toast { max-width: 100%; }
    }

    @media (max-width: 480px) {
      .quick-grid { grid-template-columns: repeat(3, 1fr); }
      .quick-btn { padding: 8px 6px; font-size: 11.5px; }
    }

    /* ─────────────────────────────────────────────
       DIVIDER
    ───────────────────────────────────────────── */
    .divider { height: 1px; background: var(--border); margin: 20px 0; }

    /* ─────────────────────────────────────────────
       STATUS BADGE
    ───────────────────────────────────────────── */
    .status-online {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 12px; font-weight: 600; color: var(--green);
    }
    .status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green); animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(0,182,122,.4); }
      50% { box-shadow: 0 0 0 5px rgba(0,182,122,0); }
    }

    /* ─────────────────────────────────────────────
       NAMING TOOL RESULT PREVIEW
    ───────────────────────────────────────────── */
    .naming-preview {
      background: var(--surface2); border: 1.5px solid var(--border);
      border-radius: var(--radius-sm); padding: 12px 16px;
      font-family: var(--mono); font-size: 13px; color: var(--text);
      letter-spacing: 0.01em; line-height: 1.8;
      margin-top: 14px; min-height: 46px;
    }
    .naming-preview .part { color: var(--text-muted); }
    .naming-preview .val { color: var(--accent); font-weight: 500; }

    /* Scroll indicator for mobile */
    @media (max-width: 600px) {
      .clocks-scroll::after {
        content: '→';
        color: var(--text-faint); font-size: 18px;
        display: flex; align-items: center;
        padding-right: 8px; flex-shrink: 0;
      }
    }

    /* SA coverage table */
    .sa-table th { background: #0a0f1e; color: #fff; }
    .dark .sa-table th { background: var(--navy); }

    /* ─────────────────────────────────────────────
       CLI HUB STYLES
    ───────────────────────────────────────────── */
    /* CLI Category Section */
    .cli-cat-section {
      margin-bottom: 28px;
      animation: fadeIn .3s ease;
    }
    .cli-cat-section.collapsed {
      display: block;
    }
    .cli-cat-section.sub-cat {
      margin-left: 24px;
      padding-left: 20px;
      border-left: 2px solid var(--accent-soft);
      margin-bottom: 20px;
    }

    /* CLI Category Header */
    .cli-cat-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      cursor: pointer;
      user-select: none;
      margin-bottom: 10px;
    }
    .cli-cat-section.collapsed .cli-cat-header {
      display: flex;
    }
    .cli-cat-icon { font-size: 16px; }
    .cli-cat-name {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .cli-cat-count {
      font-size: 10px;
      color: var(--text-faint);
      background: var(--surface2);
      border: 1px solid var(--border);
      padding: 2px 6px;
      border-radius: var(--radius-sm);
    }
    .cli-cat-del-btn {
      background: none;
      border: none;
      color: var(--text-faint);
      cursor: pointer;
      width: 24px;
      height: 24px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: var(--transition);
    }
    .cli-cat-del-btn:hover {
      color: var(--red);
      background: var(--red-soft);
    }
    .cli-cat-toggle {
      margin-left: auto;
      background: none;
      border: none;
      color: var(--text-faint);
      cursor: pointer;
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: var(--transition);
    }
    .cli-cat-toggle:hover {
      color: var(--accent);
      background: var(--accent-soft);
    }
    .cli-cat-toggle i { transition: transform .2s var(--transition); }
    .cli-cat-section.collapsed .cli-cat-toggle i { transform: rotate(-90deg); }
    .cli-cat-line {
      height: 1px;
      background: linear-gradient(to right, var(--accent-soft), transparent);
      margin-bottom: 14px;
    }
    .cli-cat-section.collapsed .cli-cat-line {
      display: block;
    }

    /* CLI Commands Grid */
    .cli-cmds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 10px;
    }
    .cli-cat-section.collapsed .cli-cmds-grid { display: none !important; }

    /* CLI Command Card */
    .cli-cmd-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 14px 12px;
      position: relative;
      cursor: default;
      transition: var(--transition);
      overflow: hidden;
    }
    .cli-cmd-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--accent-soft), transparent);
      opacity: 0;
      transition: opacity .3s var(--transition);
      border-radius: inherit;
    }
    .cli-cmd-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .cli-cmd-card:hover::before { opacity: 1; }
    .cli-cmd-card.user-added {
      border-color: rgba(16, 185, 129, .2);
    }
    .cli-cmd-card.hidden { display: none !important; }
    .cli-cmd-icon {
      font-size: 17px;
      margin-bottom: 8px;
      display: block;
    }
    .cli-cmd-title {
      font-size: 12.5px;
      font-weight: 500;
      color: var(--text);
      line-height: 1.45;
      margin-bottom: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .cli-cmd-syn {
      font-family: var(--mono);
      font-size: 10.5px;
      color: var(--green);
      background: var(--green-soft);
      border: 1px solid rgba(16, 185, 129, .15);
      padding: 4px 8px;
      border-radius: var(--radius-sm);
      word-break: break-all;
      line-height: 1.5;
    }
    .cli-cmd-acts {
      position: absolute;
      top: 8px;
      right: 8px;
      display: flex;
      gap: 4px;
      opacity: 0;
      transition: opacity .15s;
    }
    .cli-cmd-card:hover .cli-cmd-acts { opacity: 1; }
    .cli-cmd-act {
      width: 24px;
      height: 24px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      font-size: 11px;
      transition: var(--transition);
    }
    .cli-cmd-act.cp {
      background: rgba(0, 87, 255, .8);
      color: #fff;
    }
    .cli-cmd-act.cp:hover { background: var(--accent); }
    .cli-cmd-act.ed {
      background: rgba(16, 185, 129, .8);
      color: #fff;
    }
    .cli-cmd-act.ed:hover { background: var(--green); }
    .cli-cmd-act.dl {
      background: rgba(229, 62, 62, .8);
      color: #fff;
    }
    .cli-cmd-act.dl:hover { background: var(--red); }

    /* Print styles */
    @media print {
      .sidebar, .topbar, .toast-container, .modal-overlay { display: none !important; }
      .main { margin-left: 0 !important; padding: 0 !important; }
      .card { box-shadow: none !important; border: 1px solid #ddd !important; }
      body { background: #fff !important; color: #000 !important; }
    }

    /* ─────────────────────────────────────────────
       KB RESOURCE HUB STYLES
    ───────────────────────────────────────────── */
    /* KB search bar */
    .kb-search-wrap {
      position: relative; margin-bottom: 22px;
    }
    .kb-search-wrap input {
      width: 100%; padding: 11px 16px 11px 42px;
      background: var(--surface); border: 1.5px solid var(--border);
      border-radius: var(--radius); font-size: 14px; color: var(--text);
      outline: none; font-family: var(--font);
      transition: all var(--transition);
    }
    .kb-search-wrap input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0,87,255,.1); }
    .kb-search-wrap input::placeholder { color: var(--text-faint); }
    .kb-search-icon {
      position: absolute; left: 14px; top: 50%;
      transform: translateY(-50%); color: var(--text-faint);
      pointer-events: none; font-size: 15px;
    }
    .kb-search-clear {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%);
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 50%; width: 22px; height: 22px;
      color: var(--text-faint); font-size: 13px; cursor: pointer;
      display: none; align-items: center; justify-content: center;
      transition: all var(--transition);
    }
    .kb-search-clear.visible { display: flex; }
    .kb-search-clear:hover { color: var(--text); background: var(--border); }

    /* KB stats row */
    .kb-stats {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 10px; margin-bottom: 24px;
    }
    @media (max-width: 600px) { .kb-stats { grid-template-columns: repeat(2,1fr); } }

    .kb-stat {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 14px 16px;
      position: relative; overflow: hidden;
      transition: border-color var(--transition);
    }
    .kb-stat:hover { border-color: var(--accent); }
    .kb-stat::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0;
      height: 2px; background: linear-gradient(90deg, var(--accent), #00c8e0);
      opacity: 0; transition: opacity var(--transition);
    }
    .kb-stat:hover::before { opacity: 1; }
    .kb-stat-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-faint); margin-bottom: 5px; }
    .kb-stat-value { font-size: 24px; font-weight: 700; color: var(--text); line-height: 1; }
    .kb-stat-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 24px; opacity: .08; }

    /* KB section header */
    .kb-section { margin-bottom: 36px; }
    .kb-section.collapsed {
      display: block;
    }
    .kb-section-head {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 14px;
      cursor: pointer;
    }
    .kb-section.collapsed .kb-section-head {
      display: flex;
    }
    .kb-section-head h3 { font-size: 14.5px; font-weight: 700; color: var(--text); }
    .kb-section-divider { flex: 1; height: 1px; background: var(--border); }
    .kb-section-count { font-size: 11px; color: var(--text-faint); font-family: var(--mono); }
    .kb-section-icon { font-size: 16px; }
    .kb-section-toggle {
      background: none;
      border: none;
      color: var(--text-faint);
      cursor: pointer;
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: var(--transition);
    }
    .kb-section-toggle:hover {
      color: var(--accent);
      background: var(--accent-soft);
    }
    .kb-section-toggle i { transition: transform .2s var(--transition); }
    .kb-section.collapsed .kb-section-toggle i { transform: rotate(-90deg); }

    /* KB links grid */
    .kb-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 10px;
    }
    .kb-section.collapsed .kb-grid { display: none !important; }

    /* KB link card */
    .kb-link-card {
      display: flex; align-items: flex-start; gap: 11px;
      padding: 14px; background: var(--surface);
      border: 1.5px solid var(--border); border-radius: var(--radius);
      text-decoration: none; color: var(--text);
      transition: all var(--transition); position: relative;
      overflow: hidden; min-height: 72px;
    }
    .kb-link-card:hover {
      border-color: var(--accent); background: var(--surface2);
      transform: translateY(-2px); box-shadow: var(--shadow);
      color: var(--text);
    }
    .kb-link-card.kb-hidden { display: none; }

    .kb-card-icon {
      width: 36px; height: 36px; flex-shrink: 0;
      background: var(--accent-soft); border: 1px solid rgba(0,87,255,.15);
      border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;
      font-size: 17px; transition: all var(--transition);
    }
    .dark .kb-card-icon { background: var(--accent-soft); }
    .kb-link-card:hover .kb-card-icon { background: rgba(0,87,255,.2); border-color: rgba(0,87,255,.35); }

    .kb-card-body { flex: 1; min-width: 0; }
    .kb-card-title { font-size: 13px; font-weight: 600; line-height: 1.4; margin-bottom: 3px; }
    .kb-card-url {
      font-size: 11px; color: var(--text-faint);
      font-family: var(--mono); overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap;
    }

    .kb-card-arrow {
      align-self: center; color: var(--text-faint);
      opacity: 0; font-size: 13px; flex-shrink: 0;
      transform: translateX(-4px); transition: all var(--transition);
    }
    .kb-link-card:hover .kb-card-arrow { opacity: 1; transform: translateX(0); }

    .kb-card-del {
      position: absolute; top: 7px; right: 7px;
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--red-soft); border: 1px solid rgba(229,62,62,.2);
      color: var(--red); font-size: 13px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity var(--transition);
      z-index: 2;
    }
    .kb-link-card:hover .kb-card-del { opacity: 1; }
    .kb-card-del:hover { background: rgba(229,62,62,.2); }

    /* KB no results */
    .kb-no-results {
      display: none; text-align: center;
      padding: 60px 20px; color: var(--text-faint);
    }
    .kb-no-results.show { display: block; }
    .kb-no-results-icon { font-size: 42px; margin-bottom: 14px; opacity: .5; }
    .kb-no-results h3 { font-size: 15px; color: var(--text-muted); margin-bottom: 6px; }

    /* KB toolbar */
    .kb-toolbar {
      display: flex; gap: 8px; align-items: center;
      flex-wrap: wrap; margin-bottom: 20px;
    }

    /* KB category filter chips */
    .kb-filter-chip {
      padding: 5px 13px; border-radius: 100px;
      border: 1.5px solid var(--border); background: var(--surface);
      font-size: 12px; font-weight: 600; color: var(--text-muted);
      cursor: pointer; transition: all var(--transition);
      white-space: nowrap;
    }
    .kb-filter-chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
    .kb-filter-chip.active { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

    /* KB add link modal overrides */
    .kb-modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5);
      backdrop-filter: blur(6px); z-index: 600;
      display: flex; align-items: center; justify-content: center;
      padding: 16px; opacity: 0; pointer-events: none;
      transition: opacity .2s ease;
    }
    .kb-modal-overlay.open { opacity: 1; pointer-events: all; }
    .kb-modal-box {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);
      width: 100%; max-width: 500px; max-height: 88vh; overflow-y: auto;
      transform: translateY(16px) scale(.97); opacity: 0;
      transition: all .22s cubic-bezier(.22,.68,0,1.2);
    }
    .kb-modal-overlay.open .kb-modal-box { transform: translateY(0) scale(1); opacity: 1; }

    .kb-modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 22px; border-bottom: 1px solid var(--border);
      position: sticky; top: 0; background: var(--surface); z-index: 1;
    }
    .kb-modal-head h2 { font-size: 15px; font-weight: 700; }
    .kb-modal-close {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--surface2); border: 1px solid var(--border);
      color: var(--text-muted); font-size: 15px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all var(--transition);
    }
    .kb-modal-close:hover { background: var(--red-soft); color: var(--red); }
    .kb-modal-body { padding: 18px 22px; }
    .kb-modal-foot {
      padding: 14px 22px; border-top: 1px solid var(--border);
      display: flex; gap: 8px; justify-content: flex-end;
    }

    /* manage categories list */
    .kb-cat-list { display: flex; flex-direction: column; gap: 6px; max-height: 240px; overflow-y: auto; margin-bottom: 14px; }
    .kb-cat-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; background: var(--surface2);
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      transition: border-color var(--transition);
    }
    .kb-cat-item:hover { border-color: var(--border2); }
    .kb-cat-item.is-default { border-left: 2px solid var(--accent); }
    .kb-cat-item.is-custom  { border-left: 2px solid var(--green); }
    .kb-cat-name { flex: 1; font-size: 13px; font-weight: 500; }
    .kb-cat-actions { display: flex; gap: 4px; }
    .kb-cat-btn {
      width: 26px; height: 26px; border-radius: var(--radius-sm);
      border: 1px solid var(--border); background: var(--surface);
      color: var(--text-muted); font-size: 12px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all var(--transition);
    }
    .kb-cat-btn:hover { background: var(--surface2); color: var(--text); }
    .kb-cat-btn.danger:hover { background: var(--red-soft); border-color: rgba(229,62,62,.3); color: var(--red); }
    .kb-cat-btn:disabled { opacity: .25; pointer-events: none; }

    /* backup box inside KB modals */
    .kb-backup-box {
      background: var(--accent-soft); border: 1px solid rgba(0,87,255,.2);
      border-radius: var(--radius-sm); padding: 14px; margin-bottom: 14px;
    }
    .kb-backup-box h4 { font-size: 13px; font-weight: 700; color: var(--accent); margin-bottom: 4px; }
    .kb-backup-box p { font-size: 12px; color: var(--text-muted); margin-bottom: 10px; }
    .kb-backup-actions { display: flex; gap: 8px; }
    .dark .kb-backup-box { background: var(--accent-soft); }
  </style>
</head>

<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Mobile overlay -->
  <div class="mobile-overlay" id="mobileOverlay" onclick="closeSidebar()"></div>

  <!-- Toast container -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- Modal: Edit Messages -->
  <div class="modal-overlay" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
    <div class="modal-box">
      <div class="modal-head">
        <h2 id="editModalTitle">Edit Button Messages</h2>
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
      </div>
      <div class="modal-body" id="editModalBody"></div>
      <div class="modal-foot">
