  function wcGetBaseDate() {
    const dateStr = document.getElementById('wcDate').value;
    const timeStr = document.getElementById('wcTime').value || '12:00';
    const sourceZone = document.getElementById('wcSource').value;
    if (!sourceZone) return new Date();
    const [y,mo,d] = dateStr.split('-').map(Number);
    const [h,mi] = timeStr.split(':').map(Number);
    const utc = new Date(Date.UTC(y, mo-1, d, h, mi, 0));
    const f = new Intl.DateTimeFormat('en-US', { timeZone: sourceZone, hour:'2-digit', minute:'2-digit', hour12: false });
    const p = f.formatToParts(utc);
    const sh = parseInt(p.find(x=>x.type==='hour').value);
    const sm = parseInt(p.find(x=>x.type==='minute').value);
    return new Date(utc.getTime() - ((sh*60+sm)-(h*60+mi))*60000);
  }

