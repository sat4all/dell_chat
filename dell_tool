  // Storage keys
  const CLI_KEYS = {
    u: 'cli_user_commands',
    c: 'cli_custom_categories',
    d: 'cli_deleted_commands',
    col: 'cli_collapsed'
  };

  const CLI_STORE = {
    get: k => { try { return JSON.parse(localStorage.getItem(k)) || []; } catch { return []; } },
    set: (k,v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch { toast('Storage error','⚠️'); } }
  };

  const CLI_GET_COL = () => { try { return JSON.parse(localStorage.getItem(CLI_KEYS.col)) || {}; } catch { return {}; } };
  const CLI_SET_COL = (id,v) => { const s = CLI_GET_COL(); s[id] = v; localStorage.setItem(CLI_KEYS.col, JSON.stringify(s)); };

  // Helper to sanitize HTML
  function cliSanitize(s) {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  // Get all categories (default + custom)
  function cliGetAllCats() {
    const st = CLI_STORE.get(CLI_KEYS.c);
    const delIds = st.filter(c => c.isDeleted).map(c => c.id);
    const cus = st.filter(c => !c.isDeleted);
    const def = CLI_DEFAULT_CATS.filter(c => !delIds.includes(c.id));
    const merged = [...def];
    cus.forEach(c => {
      const i = merged.findIndex(x => x.id === c.id);
      i !== -1 ? merged[i] = c : merged.push(c);
    });
    return merged;
  }

  // Update stats
  function cliUpdateStats() {
    const uc = CLI_STORE.get(CLI_KEYS.u);
    const del = CLI_STORE.get(CLI_KEYS.d);
    let tot = uc.length;
    CLI_DEFAULT_CATS.forEach(c => {
      (c.commands || []).forEach(cmd => {
        if (!del.includes(cmd.id) && !uc.some(u => u.id === cmd.id)) tot++;
      });
    });
    document.getElementById('cliTotalCmds').textContent = tot;
    document.getElementById('cliTotalCats').textContent = cliGetAllCats().length;
    document.getElementById('cliUserCmds').textContent = uc.length;
  }

  // Build command card
  function cliBuildCard(cmd, isUser, catId) {
    const card = document.createElement('div');
    card.className = 'cli-cmd-card' + (isUser ? ' user-added' : '');
    card.dataset.id = cmd.id;
    card.dataset.isUs = isUser;
    card.dataset.srch = `${(cmd.title || '').toLowerCase()} ${(cmd.url || '').toLowerCase()}`;
    card.innerHTML = `
      <span class="cli-cmd-icon">${cmd.icon || '🔗'}</span>
      <div class="cli-cmd-title">${cliSanitize(cmd.title)}</div>
      <div class="cli-cmd-syn" title="${cliSanitize(cmd.url)}">${cliSanitize(cmd.url)}</div>
      <div class="cli-cmd-acts">
        <button class="cli-cmd-act cp" title="Copy">📋</button>
        <button class="cli-cmd-act ed" title="Edit">✏️</button>
        <button class="cli-cmd-act dl" title="Delete">🗑️</button>
      </div>
    `;
    
    card.querySelector('.cp').addEventListener('click', e => {
      e.stopPropagation();
      copyText(cmd.url).then(() => {
        const b = card.querySelector('.cp');
        b.textContent = '✓';
        b.style.background = 'var(--green)';
        toast('Copied: ' + cmd.url.substring(0, 50));
        setTimeout(() => {
          b.textContent = '📋';
          b.style.background = '';
        }, 1600);
      });
    });
    
    card.querySelector('.ed').addEventListener('click', e => { e.stopPropagation(); cliOpenEdit(cmd, isUser, catId); });
    
    card.querySelector('.dl').addEventListener('click', e => {
      e.stopPropagation();
      if (!confirm('Delete this command?')) return;
      if (isUser) {
        CLI_STORE.set(CLI_KEYS.u, CLI_STORE.get(CLI_KEYS.u).filter(c => c.id !== cmd.id));
      } else {
        const d = CLI_STORE.get(CLI_KEYS.d);
        if (!d.includes(cmd.id)) {
          d.push(cmd.id);
          CLI_STORE.set(CLI_KEYS.d, d);
        }
      }
      card.remove();
      cliUpdateStats();
      toast('Command deleted', '⚠️');
    });
    
    return card;
  }

  // Build category section
  function cliBuildSec(cat, allC, uc, del, isSub, ai) {
    const sec = document.createElement('div');
    sec.className = 'cli-cat-section' + (isSub ? ' sub-cat' : '');
    sec.id = `cli-cs-${cat.id}`;
    sec.style.animationDelay = `${Math.min(ai * 0.04, 0.35)}s`;
    
    const dc = CLI_DEFAULT_CATS.find(d => d.id === cat.id);
    const defC = (dc?.commands || []).filter(c => !del.includes(c.id) && !uc.some(u => u.id === c.id));
    const uCC = uc.filter(c => c.category === cat.id);
    const cnt = defC.length + uCC.length;
    
    const hdr = document.createElement('div');
    hdr.className = 'cli-cat-header';
    hdr.innerHTML = `
      <span class="cli-cat-icon">${cat.icon}</span>
      <span class="cli-cat-name">${cliSanitize(cat.name)}</span>
      <span class="cli-cat-count">${cnt}</span>
      ${isSub ? `<button class="cli-cat-del-btn" data-cid="${cat.id}">✕</button>` : ''}
      <button class="cli-cat-toggle"><i>▼</i></button>
    `;
    
    const line = document.createElement('div');
    line.className = 'cli-cat-line';
    
    const grid = document.createElement('div');
    grid.className = 'cli-cmds-grid';
    grid.id = `cli-grid-${cat.id}`;
    defC.forEach(cmd => grid.appendChild(cliBuildCard(cmd, false, cat.id)));
    uCC.forEach(cmd => grid.appendChild(cliBuildCard(cmd, true, cat.id)));
    
    sec.append(hdr, line, grid);
    
    const col = CLI_GET_COL();
    // Only collapse if explicitly set to true in localStorage
    if (col[cat.id] === true) {
      sec.classList.add('collapsed');
    }
    
    // Toggle collapse when clicking the toggle button
    const toggleBtn = hdr.querySelector('.cli-cat-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', e => {
        e.stopPropagation();
        const isC = sec.classList.toggle('collapsed');
        CLI_SET_COL(cat.id, isC);
      });
    }
    
    const dB = hdr.querySelector('.cli-cat-del-btn');
    if (dB) {
      dB.addEventListener('click', e => {
        e.stopPropagation();
        cliDeleteCat(cat.id);
      });
    }
    
    return sec;
  }

  // Render all
  function cliRenderAll() {
    const cont = document.getElementById('cliCatsContainer');
    cont.innerHTML = '';
    const allC = cliGetAllCats();
    const uc = CLI_STORE.get(CLI_KEYS.u);
    const del = CLI_STORE.get(CLI_KEYS.d);
    const top = allC.filter(c => !c.parentId);
    
    top.forEach((cat, i) => {
      cont.appendChild(cliBuildSec(cat, allC, uc, del, false, i));
      allC.filter(c => c.parentId === cat.id).forEach((s, j) => {
        cont.appendChild(cliBuildSec(s, allC, uc, del, true, j));
      });
    });
    
    cliBuildDrops();
    cliUpdateStats();
  }

  // Build dropdowns
  function cliBuildDrops() {
    const allC = cliGetAllCats();
    const pop = (selId, withAll = false) => {
      const sel = document.getElementById(selId);
      if (!sel) return;
      const prev = sel.value;
      let html = withAll ? '<option value="all">All Categories</option>' : '<option value="">Select a category…</option>';
      const addO = (cat, lvl) => {
        html += `<option value="${cat.id}">${'  '.repeat(lvl)}${cat.icon} ${cat.name}</option>`;
        allC.filter(c => c.parentId === cat.id).forEach(s => addO(s, lvl + 1));
      };
      allC.filter(c => !c.parentId).forEach(c => addO(c, 0));
      sel.innerHTML = html;
      if (prev && [...sel.options].some(o => o.value === prev)) sel.value = prev;
    };
    pop('cliSearchScope', true);
    pop('cliAddCat');
    pop('cliEditCat');
    pop('cliCatParent');
  }

  // Search
  let cliSearchTimer;
  function cliDoSearch() {
    const term = document.getElementById('cliSearchInput').value.toLowerCase().trim();
    const scope = document.getElementById('cliSearchScope').value;
    const clearBtn = document.getElementById('cliSearchClear');
    let vis = 0;

    // Show/hide clear button
    clearBtn.classList.toggle('visible', term);

    document.querySelectorAll('.cli-cmd-card').forEach(card => {
      const txt = card.dataset.srch || '';
      const catId = card.closest('.cli-cmds-grid')?.id?.replace('cli-grid-', '');
      const match = (!term || txt.includes(term)) && (scope === 'all' || catId === scope);
      card.classList.toggle('hidden', !match);
      if (match) vis++;
    });

    document.getElementById('cliNoResults').classList.toggle('show', vis === 0 && (term || scope !== 'all'));
  }

  // Modal helpers
  function cliOpenModal(id) {
    document.getElementById(id).classList.add('open');
  }
  function cliCloseModal(id) {
    document.getElementById(id).classList.remove('open');
    const f = document.querySelector(`#${id} form`);
    if (f) f.reset();
  }

  // Add command
  function cliOpenAdd() {
    cliBuildDrops();
    cliOpenModal('cliAddModal');
    setTimeout(() => document.getElementById('cliAddTitle').focus(), 80);
  }

  document.getElementById('cliAddForm').addEventListener('submit', e => {
    e.preventDefault();
    const title = document.getElementById('cliAddTitle').value.trim();
    const url = document.getElementById('cliAddUrl').value.trim();
    const cat = document.getElementById('cliAddCat').value;
    const icon = document.getElementById('cliAddIcon').value.trim() || '🔗';
    
    if (!title || !url || !cat) {
      toast('Please fill all required fields', '⚠️');
      return;
    }
    
    const cmd = {
      id: Date.now().toString(),
      title: cliSanitize(title),
      url,
      category: cat,
      icon: cliSanitize(icon)
    };
    
    const cmds = CLI_STORE.get(CLI_KEYS.u);
    cmds.push(cmd);
    CLI_STORE.set(CLI_KEYS.u, cmds);
    
    const grid = document.getElementById(`cli-grid-${cat}`);
    if (!grid) {
      cliRenderAll();
    } else {
      grid.appendChild(cliBuildCard(cmd, true, cat));
      cliUpdateStats();
    }
    
    cliCloseModal('cliAddModal');
    toast('Command added');
  });

  // Edit command
  function cliOpenEdit(cmd, isUser, catId) {
    cliBuildDrops();
    document.getElementById('cliEditId').value = cmd.id;
    document.getElementById('cliEditIsUser').value = isUser;
    document.getElementById('cliEditOrigCat').value = catId;
    document.getElementById('cliEditTitle').value = cmd.title;
    document.getElementById('cliEditUrl').value = cmd.url;
    document.getElementById('cliEditIcon').value = cmd.icon || '🔗';
    setTimeout(() => {
      document.getElementById('cliEditCat').value = catId;
      cliOpenModal('cliEditModal');
      document.getElementById('cliEditTitle').focus();
    }, 50);
  }

  document.getElementById('cliEditForm').addEventListener('submit', e => {
    e.preventDefault();
    const id = document.getElementById('cliEditId').value;
    const isUser = document.getElementById('cliEditIsUser').value === 'true';
    const origCat = document.getElementById('cliEditOrigCat').value;
    const title = document.getElementById('cliEditTitle').value.trim();
    const url = document.getElementById('cliEditUrl').value.trim();
    const cat = document.getElementById('cliEditCat').value;
    const icon = document.getElementById('cliEditIcon').value.trim() || '🔗';
    
    if (!title || !url || !cat) {
      toast('Please fill all required fields', '⚠️');
      return;
    }
    
    const upd = {
      id,
      title: cliSanitize(title),
      url,
      category: cat,
      icon: cliSanitize(icon)
    };
    
    const cmds = CLI_STORE.get(CLI_KEYS.u);
    const idx = cmds.findIndex(c => c.id === id);
    if (idx !== -1) {
      cmds[idx] = upd;
    } else {
      cmds.push(upd);
      if (!isUser) {
        const d = CLI_STORE.get(CLI_KEYS.d);
        if (!d.includes(id)) {
          d.push(id);
          CLI_STORE.set(CLI_KEYS.d, d);
        }
      }
    }
    CLI_STORE.set(CLI_KEYS.u, cmds);
    
    const card = document.querySelector(`.cli-cmd-card[data-id="${id}"]`);
    const og = document.getElementById(`cli-grid-${origCat}`);
    const ng = document.getElementById(`cli-grid-${cat}`);
    if (card) {
      card.querySelector('.cli-cmd-title').textContent = title;
      card.querySelector('.cli-cmd-syn').textContent = url;
      card.querySelector('.cli-cmd-icon').textContent = cliSanitize(icon);
      card.dataset.srch = `${title.toLowerCase()} ${url.toLowerCase()}`;
      card.dataset.isUs = true;
      if (og && ng && og !== ng) {
        card.remove();
        ng.appendChild(card);
      }
    }
    
    cliCloseModal('cliEditModal');
    toast('Command updated');
  });

  // Category modal
  function cliOpenCategories() {
    cliRenderCatList();
    cliBuildDrops();
    cliOpenModal('cliCatModal');
  }

  function cliRenderCatList() {
    const wrap = document.getElementById('cliCatList');
    const allC = cliGetAllCats();
    wrap.innerHTML = '';
    
    if (!allC.length) {
      wrap.innerHTML = '<div style="padding:1rem;text-align:center;color:var(--text-faint);font-size:12px">No categories</div>';
      return;
    }
    
    const addLi = (cat, lvl) => {
      const li = document.createElement('div');
      li.className = 'kb-cat-item ' + (cat.isDefault ? 'is-default' : 'is-custom');
      if (lvl > 0) li.style.paddingLeft = `${14 + lvl * 14}px`;
      li.innerHTML = `
        <span style="font-size:17px">${cat.icon}</span>
        <span class="kb-cat-name">${cliSanitize(cat.name)}</span>
        <span class="kb-cat-actions">
          <button class="kb-cat-btn" data-edit="${cat.id}">✏️</button>
          <button class="kb-cat-btn danger" data-del="${cat.id}">🗑️</button>
        </span>
      `;
      li.querySelector('[data-edit]').addEventListener('click', () => cliEditCatPrompt(cat));
      li.querySelector('[data-del]').addEventListener('click', () => {
        cliDeleteCat(cat.id);
        cliRenderCatList();
      });
      wrap.appendChild(li);
      allC.filter(c => c.parentId === cat.id).forEach(s => addLi(s, lvl + 1));
    };
    
    allC.filter(c => !c.parentId).forEach(c => addLi(c, 0));
  }

  function cliEditCatPrompt(cat) {
    const n = prompt('Category name:', cat.name);
    if (!n?.trim()) return;
    const ic = prompt('Icon:', cat.icon) || cat.icon;
    
    const st = CLI_STORE.get(CLI_KEYS.c);
    const idx = st.findIndex(c => c.id === cat.id);
    const upd = { ...cat, name: cliSanitize(n.trim()), icon: cliSanitize(ic), isDefault: false };
    idx !== -1 ? st[idx] = upd : st.push(upd);
    CLI_STORE.set(CLI_KEYS.c, st);
    
    const sec = document.getElementById(`cli-cs-${cat.id}`);
    if (sec) {
      sec.querySelector('.cli-cat-icon').textContent = upd.icon;
      sec.querySelector('.cli-cat-name').textContent = upd.name;
    }
    cliRenderCatList();
    toast('Category updated');
  }

  function cliDeleteCat(catId) {
    const uc = CLI_STORE.get(CLI_KEYS.u);
    const cnt = uc.filter(c => c.category === catId).length;
    if (!confirm(`Delete this category?${cnt ? `\n\nAlso deletes ${cnt} custom command(s).` : ''}`)) return;
    
    const cat = cliGetAllCats().find(c => c.id === catId);
    const st = CLI_STORE.get(CLI_KEYS.c);
    
    if (cat?.isDefault) {
      const f = st.filter(c => c.id !== catId);
      f.push({ id: catId, name: cat.name, icon: cat.icon, isDefault: true, isDeleted: true });
      CLI_STORE.set(CLI_KEYS.c, f);
    } else {
      CLI_STORE.set(CLI_KEYS.c, st.filter(c => c.id !== catId));
    }
    
    CLI_STORE.set(CLI_KEYS.u, uc.filter(c => c.category !== catId));
    document.getElementById(`cli-cs-${catId}`)?.remove();
    cliBuildDrops();
    cliUpdateStats();
    toast('Category deleted', '⚠️');
  }

  function cliAddCategory() {
    const name = document.getElementById('cliCatName').value.trim();
    const icon = document.getElementById('cliCatIcon').value.trim() || '📁';
    const parent = document.getElementById('cliCatParent').value || null;
    
    if (!name) {
      toast('Name is required', '⚠️');
      return;
    }
    
    const nc = {
      id: 'cus_' + Date.now(),
      name: cliSanitize(name),
      icon: cliSanitize(icon),
      isDefault: false,
      parentId: parent || null
    };
    
    const st = CLI_STORE.get(CLI_KEYS.c);
    st.push(nc);
    CLI_STORE.set(CLI_KEYS.c, st);
    
    const allC = cliGetAllCats();
    const uc = CLI_STORE.get(CLI_KEYS.u);
    const del = CLI_STORE.get(CLI_KEYS.d);
    document.getElementById('cliCatsContainer').appendChild(cliBuildSec(nc, allC, uc, del, !!parent, 0));
    
    cliRenderCatList();
    cliBuildDrops();
    cliUpdateStats();
    document.getElementById('cliCatName').value = '';
    document.getElementById('cliCatIcon').value = '';
    toast('Category added');
  }

  // Backup/Restore
  function cliOpenBackup() {
    cliOpenModal('cliBackupModal');
  }

  function cliExport() {
    const data = {
      userCommands: CLI_STORE.get(CLI_KEYS.u),
      customCategories: CLI_STORE.get(CLI_KEYS.c),
      deletedCommands: CLI_STORE.get(CLI_KEYS.d),
      exportDate: new Date().toISOString()
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = Object.assign(document.createElement('a'), {
      href: url,
      download: `cli-backup-${new Date().toISOString().slice(0, 10)}.json`
    });
    a.click();
    URL.revokeObjectURL(url);
    toast('Backup exported');
  }

  function cliImport(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        if (!data || typeof data !== 'object') throw new Error('Invalid format');
        
        const rep = confirm('Replace existing data?\n\nOK = Replace all  |  Cancel = Merge only new');
        if (rep) {
          if (Array.isArray(data.userCommands)) CLI_STORE.set(CLI_KEYS.u, data.userCommands);
          if (Array.isArray(data.customCategories)) CLI_STORE.set(CLI_KEYS.c, data.customCategories);
          if (Array.isArray(data.deletedCommands)) CLI_STORE.set(CLI_KEYS.d, data.deletedCommands);
          toast('Data replaced — reloading…');
        } else {
          if (Array.isArray(data.userCommands)) {
            const ex = CLI_STORE.get(CLI_KEYS.u);
            const ids = new Set(ex.map(c => c.id));
            CLI_STORE.set(CLI_KEYS.u, [...ex, ...data.userCommands.filter(c => !ids.has(c.id))]);
          }
          if (Array.isArray(data.customCategories)) {
            const ex = CLI_STORE.get(CLI_KEYS.c);
            const ids = new Set(ex.map(c => c.id));
            CLI_STORE.set(CLI_KEYS.c, [...ex, ...data.customCategories.filter(c => !ids.has(c.id))]);
          }
          toast('Data merged — reloading…');
        }
        setTimeout(() => location.reload(), 1000);
      } catch (err) {
        toast('Import failed: ' + err.message, '⚠️');
      }
      e.target.value = '';
    };
    reader.readAsText(file);
  }

  // Event wiring
  document.getElementById('cliSearchInput').addEventListener('input', () => {
    clearTimeout(cliSearchTimer);
    cliSearchTimer = setTimeout(cliDoSearch, 140);
  });
  document.getElementById('cliSearchScope').addEventListener('change', cliDoSearch);

  // CLI init
  function cliInit() {
    cliRenderAll();
  }

  // Add CLI init to DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    cliInit();
  });

  </script>
</body>
</html>
