  function kbRenderCatList() {
    const list = document.getElementById('kbCatList');
    list.innerHTML = '';
    kbAllCats().forEach(cat => {
      const div = document.createElement('div');
      div.className = 'kb-cat-item ' + (cat.isDefault ? 'is-default' : 'is-custom');
      div.innerHTML = `
        <span style="font-size:17px">${cat.icon}</span>
        <span class="kb-cat-name">${kbSanitize(cat.name)}</span>
        <div class="kb-cat-actions">
          <button class="kb-cat-btn" title="Edit" aria-label="Edit ${kbSanitize(cat.name)}">✏️</button>
          <button class="kb-cat-btn danger" title="Delete" aria-label="Delete ${kbSanitize(cat.name)}" ${cat.isDefault ? 'disabled' : ''}>🗑️</button>
        </div>
      `;
      const [editBtn, delBtn] = div.querySelectorAll('.kb-cat-btn');
      editBtn.addEventListener('click', () => kbEditCategory(cat));
      if (!cat.isDefault) delBtn.addEventListener('click', () => kbDeleteCategory(cat.id));
      list.appendChild(div);
    });
  }

  function kbAddCategory() {
    const name = document.getElementById('kbNewCatName').value.trim();
    const icon = document.getElementById('kbNewCatIcon').value.trim();
    if (!name) { toast('Category name required','⚠️'); return; }

    const newCat = { id:'cat_'+Date.now(), name:kbSanitize(name), icon:kbSanitize(icon)||'📁', isDefault:false };
    const cats = KB_STORE.cats(); cats.push(newCat); KB_STORE.set(KB_KEYS.cats, cats);

    const sec = kbMakeSection(newCat, []);
    document.getElementById('kbUserSectionsContainer').appendChild(sec);

    document.getElementById('kbNewCatName').value = '';
    document.getElementById('kbNewCatIcon').value = '';
    kbRenderCatList();
    kbUpdateStats();
    kbPopulateCatDropdown();
    kbRebuildFilterChips();
    toast('Category added!');
  }

  function kbEditCategory(cat) {
    const newName = prompt('Category name:', cat.name);
    if (!newName?.trim()) return;
    const newIcon = prompt('Icon (emoji):', cat.icon) || cat.icon;

    if (cat.isDefault) {
      const c = KB_STORE.custom();
      c[cat.id] = { name: kbSanitize(newName.trim()), icon: kbSanitize(newIcon) };
      KB_STORE.set(KB_KEYS.custom, c);
    } else {
      const cats = KB_STORE.cats();
      const idx = cats.findIndex(c => c.id === cat.id);
      if (idx > -1) { cats[idx].name = kbSanitize(newName.trim()); cats[idx].icon = kbSanitize(newIcon); KB_STORE.set(KB_KEYS.cats, cats); }
    }

    kbRender();
    kbRenderCatList();
    toast('Category updated!');
  }

  function kbDeleteCategory(id) {
    const uLinks = KB_STORE.links().filter(l => l.cat === id);
    if (!confirm(`Delete this category?${uLinks.length ? `\n\nThis will also delete ${uLinks.length} custom link(s).` : ''}`)) return;
    KB_STORE.set(KB_KEYS.cats, KB_STORE.cats().filter(c => c.id !== id));
    KB_STORE.set(KB_KEYS.links, KB_STORE.links().filter(l => l.cat !== id));
    document.getElementById('kb-cat-' + id)?.remove();
    kbRenderCatList();
    kbUpdateStats();
    kbRebuildFilterChips();
    toast('Category deleted');
  }

  // ─── EXPORT / IMPORT ───
  function kbExport() {
    const data = {
      userLinks: KB_STORE.links(),
      customCats: KB_STORE.cats(),
      deletedLinks: KB_STORE.del(),
      catCustomizations: KB_STORE.custom()
    };
    const blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'kb-backup.json';
    a.click();
    URL.revokeObjectURL(a.href);
    toast('KB data exported!');
  }

  function kbImport(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        if (!data || typeof data !== 'object') throw new Error();
        if (Array.isArray(data.userLinks)) {
          const ex = new Set(KB_STORE.links().map(l=>l.id));
          KB_STORE.set(KB_KEYS.links, [...KB_STORE.links(), ...data.userLinks.filter(l=>!ex.has(l.id))]);
        }
        if (Array.isArray(data.customCats)) {
          const ex = new Set(KB_STORE.cats().map(c=>c.id));
          KB_STORE.set(KB_KEYS.cats, [...KB_STORE.cats(), ...data.customCats.filter(c=>!ex.has(c.id))]);
        }
        if (Array.isArray(data.deletedLinks)) KB_STORE.set(KB_KEYS.del, [...new Set([...KB_STORE.del(),...data.deletedLinks])]);
        if (data.catCustomizations) KB_STORE.set(KB_KEYS.custom, {...KB_STORE.custom(),...data.catCustomizations});
        toast('Import successful — reloading…');
        setTimeout(() => location.reload(), 1200);
      } catch { toast('Invalid backup file','⚠️'); }
      e.target.value = '';
    };
    reader.readAsText(file);
  }

