    const m = (Math.abs(off) % 1) ? '30' : '00';
    TZ_DB.push({ zone: `offset:${off}`, country: 'UTC', city: `UTC${sign}${h}:${m.padStart(2,'0')}`, abbr: 'UTC' });
  }

  function getTimeInfo(zone, baseDate) {
    if (zone.startsWith('offset:')) {
      const off = parseFloat(zone.split(':')[1]);
      const utc = baseDate.getTime() + baseDate.getTimezoneOffset() * 60000;
      const d = new Date(utc + off * 3600000);
      const pad = n => String(n).padStart(2,'0');
      return { time: `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}`, offset: `UTC${off>=0?'+':''}${off}`, dst: false };
    }
    const f = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour:'2-digit', minute:'2-digit', second:'2-digit', timeZoneName:'short', hour12: false });
    const parts = f.formatToParts(baseDate);
    const g = t => parts.find(p => p.type === t)?.value || '';
    const y = baseDate.getUTCFullYear();
    const offNow = getMinOffset(zone, baseDate);
    const offJan = getMinOffset(zone, new Date(Date.UTC(y,0,1)));
    const offJul = getMinOffset(zone, new Date(Date.UTC(y,6,1)));
    const dst = offNow !== Math.max(offJan, offJul);
    return { time: `${g('hour')}:${g('minute')}:${g('second')}`, offset: g('timeZoneName'), dst };
  }

  function getMinOffset(zone, d) {
    const f = new Intl.DateTimeFormat('en-US', { timeZone: zone, hour:'2-digit', minute:'2-digit', hour12: false });
    const p = f.formatToParts(d);
    return (+p.find(x=>x.type==='hour').value)*60 + (+p.find(x=>x.type==='minute').value);
  }

